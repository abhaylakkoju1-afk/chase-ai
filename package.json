{
  "name": "chase-ai",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:emulator": "firebase emulators:exec --only auth,database --project demo-swimtics \"node --test --test-concurrency=1 test/firebase/*.test.mjs\"",
    "supabase:test-config": "node scripts/supabase-test-config.mjs",
    "supabase:production-config": "node scripts/supabase-production-config.mjs",
    "test:e2e:emulator": "firebase emulators:exec --only auth,database --project demo-swimtics \"playwright test -c playwright.emulator.config.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "^1.63.0",
    "firebase": "13.0.0",
    "firebase-tools": "15.34.0"
  }
}
