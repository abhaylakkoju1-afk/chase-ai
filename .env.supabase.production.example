# swimtics-production — copy to .env.supabase.production.local (git-ignored),
# fill in the PUBLISHABLE key, then run: npm run supabase:production-config
# That writes src/app/data/supabase-production-config.js, which IS committed:
# a publishable key is public by design (it only allows what RLS allows).
# Never put the secret / service_role key here or anywhere in the website.
# The project URL comes from PRODUCTION_PROJECT_REF in src/app/data/supabase-env.js.
SUPABASE_PRODUCTION_PUBLISHABLE_KEY=sb_publishable_...
