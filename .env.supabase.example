# SWIMTICS — Supabase TEST project (swimtics-test) connection details.
#
# 1. Copy this file to .env.supabase.local (git-ignored; never commit it).
# 2. Fill in the two values from the Supabase dashboard for swimtics-test:
#    Project Settings > API (or "Connect"): the Project URL and the
#    PUBLISHABLE key (sb_publishable_...). The legacy "anon" key also works.
# 3. Run: npm run supabase:test-config
#
# NEVER put the secret key (sb_secret_...) or the service_role key here:
# they bypass Row Level Security. The config script refuses them.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
